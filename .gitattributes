
# ==========================================
# Default: normalize text files to LF
# ==========================================
* text=auto eol=lf

# ==========================================
# Hugo content and configuration
# ==========================================
*.md       text eol=lf
*.markdown text eol=lf
*.html     text eol=lf
*.xml      text eol=lf
*.toml     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
*.jsonc    text eol=lf
*.txt      text eol=lf
*.csv      text eol=lf
*.tsv      text eol=lf

# ==========================================
# Hugo templates and assets
# ==========================================
*.css      text eol=lf
*.scss     text eol=lf
*.sass     text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.ts       text eol=lf
*.svg      text eol=lf
*.webmanifest text eol=lf

# ==========================================
# Scripts
# ==========================================
*.sh       text eol=lf
*.py       text eol=lf
*.ps1      text eol=lf

# Windows scripts: CRLF in working tree
*.bat      text eol=crlf
*.cmd      text eol=crlf

# ==========================================
# Binary files: disable text conversion
# ==========================================
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.avif     binary
*.bmp      binary

*.pdf      binary
*.zip      binary
*.gz       binary
*.7z       binary
*.rar      binary

*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.eot      binary

*.mp3      binary
*.ogg      binary
*.wav      binary
*.flac     binary
*.mp4      binary
*.webm     binary
*.mov      binary

*.exe      binary
*.dll      binary
*.so       binary
*.dylib    binary
*.wasm     binary
